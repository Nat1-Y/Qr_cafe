DATABASE_URL=postgresql://postgres:password@localhost:5432/NYT_Cafe
JWT_SECRET=your-jwt-secret-key-here
PORT=5000
BCRYPT_SALT_ROUNDS=10

# --- QR self-ordering -------------------------------------------------------
# Customer web app origin(s) allowed to call /api/public/* and the /customer
# socket (comma-separated). Add your LAN address to test from a phone, e.g.
# WEB_ORIGIN=http://localhost:3000,http://192.168.1.20:3000
WEB_ORIGIN=http://localhost:3000
# Behind a reverse proxy, set to the number of proxy hops (e.g. 1) so the
# guest rate limiter sees real client IPs.
# TRUST_PROXY=1

# --- Online payment providers (all disabled until their adapter is built) ---
# See src/modules/payment/providers/*.provider.ts for each provider's flow.
# CHAPA_SECRET_KEY=
# CHAPA_WEBHOOK_SECRET=
# CHAPA_BASE_URL=https://api.chapa.co/v1
# TELEBIRR_APP_ID=
# TELEBIRR_APP_KEY=
# TELEBIRR_SHORT_CODE=
# TELEBIRR_PUBLIC_KEY=
# TELEBIRR_PRIVATE_KEY=
# TELEBIRR_BASE_URL=
# CBE_BIRR_MERCHANT_ID=
# CBE_BIRR_API_KEY=
# CBE_BIRR_SECRET=
# CBE_BIRR_BASE_URL=

# Tests (pnpm test) only ever use this database; its name must start with qr_e2e.
# TEST_DATABASE_URL=postgresql://postgres:test@localhost:5433/qr_e2e
# Public address of the guest web app, used in printed table QR codes
# (e.g. https://order.mycafe.et). Defaults to the first WEB_ORIGIN.
# GUEST_BASE_URL=
